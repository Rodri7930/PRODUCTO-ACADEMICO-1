@page "{id:int}" 
@model PD1.Pages.Productos.DeleteModel
@{
    ViewData["Title"] = "Eliminar Producto";
}
<div class="container mt-4">
    <h2>¿Está seguro que desea eliminar este producto?</h2>
    <div class="alert alert-warning">Esta acción no se puede deshacer.</div>
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Producto.NombreProducto</dd>
        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">@Model.Producto.Descripcion</dd>
        <dt class="col-sm-2">Precio</dt>
        <dd class="col-sm-10">@Model.Producto.Precio.ToString("C")</dd>
        <dt class="col-sm-2">Stock</dt>
        <dd class="col-sm-10">@Model.Producto.Stock</dd>
    </dl>
    <form method="post">
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
