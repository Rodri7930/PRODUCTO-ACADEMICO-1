@page
@model PD1.Pages.Productos.CreateModel
@{
    ViewData["Title"] = "Agregar Producto";
}
<div class="container mt-4">
    <h2>Agregar Producto</h2>
    <form method="post">
        <div class="form-group">
            <label asp-for="Producto.NombreProducto" class="control-label">NombreProducto</label>
            <input asp-for="Producto.NombreProducto" class="form-control" />
            <span asp-validation-for="Producto.NombreProducto" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Producto.Descripcion" class="control-label">Descripcion</label>
            <textarea asp-for="Producto.Descripcion" class="form-control"></textarea>
            <span asp-validation-for="Producto.Descripcion" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Producto.Precio" class="control-label">Precio</label>
            <input asp-for="Producto.Precio" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Producto.Precio" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Producto.Stock" class="control-label">Stock</label>
            <input asp-for="Producto.Stock" class="form-control" type="number" />
            <span asp-validation-for="Producto.Stock" class="text-danger"></span>
        </div>

        <div class="form-group">
            <input type="submit" value="Guardar" class="btn btn-success" />
            <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
