@page "{id:int}"
@model PD1.Pages.Productos.EditModel
@{
    ViewData["Title"] = "Editar Producto";
}
<div class="container mt-4">
    <h2>Editar Producto</h2>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <!-- ESTA LÍNEA FALTABA - MUY IMPORTANTE -->
        <input type="hidden" asp-for="Producto.ProductoID" />

        <div class="mb-3">
            <label asp-for="Producto.NombreProducto" class="form-label"></label>
            <input asp-for="Producto.NombreProducto" class="form-control" />
            <span asp-validation-for="Producto.NombreProducto" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Producto.Descripcion" class="form-label"></label>
            <textarea asp-for="Producto.Descripcion" class="form-control"></textarea>
            <span asp-validation-for="Producto.Descripcion" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Producto.Precio" class="form-label"></label>
            <input asp-for="Producto.Precio" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Producto.Precio" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Producto.Stock" class="form-label"></label>
            <input asp-for="Producto.Stock" class="form-control" type="number" />
            <span asp-validation-for="Producto.Stock" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
